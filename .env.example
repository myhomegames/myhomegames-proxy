# Same token as Worker secret: npx wrangler secret put MYGAMES_CF_API_TOKEN
# Needs Tunnel + DNS edit and Access Users/Groups/Apps write.
MYGAMES_CF_API_TOKEN=

# Optional (defaults from wrangler.toml)
# MYGAMES_ACCOUNT_ID=

# Worker secrets (set with wrangler secret put — not for the browser):
# TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET — IGDB catalog
# OPENAI_API_KEY — shared folder-import AI (optional OPENAI_BASE_URL / OPENAI_MODEL)
